"radar_help.open" = "Miten tutka toimii";
"radar_help.products.p1" = "Tutkakartta voi näyttää kahdenlaista kuvaa. Alin keilaus näyttää kunkin tutkan alimman pyyhkäisyn: maanpintaa lähimmän kaiun, ja siten lähimmän vastineen sille sateelle, jonka oikeasti tunnet. Kaukana tutkasta sekin pyyhkäisy on korkealla, kuten yllä oleva sivukuva näyttää, joten matalista pilvistä satava sade voi jäädä näkymättä.";
"radar_help.products.p2" = "Pylväsmaksimi näyttää kartan jokaisen kohdan yläpuolelta voimakkaimman kaiun millä tahansa kulmalla, 12 kilometriin asti. Se osoittaa, missä ukkospilvien ytimet ovat, mukaan lukien sateen ja rakeet, jotka ovat vielä korkealla pilvessä eivätkä ole vielä pudonneet tai jotka haihtuvat matkalla alas. Se ei siis välttämättä ole sadetta maassa: se näyttää yleensä voimakkaammalta ja laajemmalta kuin alin keilaus, ja se voi näyttää sadetta siellä, missä alhaalla pysyy kuivaa.";
"radar_help.products.p3" = "Pylväsmaksimi tarvitsee koko tilavuuskeilauksen, joten se on yhden keilauksen tai enemmän jäljessä. DMAX on DWD:n pylväsmaksimi Saksalle; meteocool tekee oman kaikista kuudestatoista tutkaverkosta. Ukkossolut ja 3D-pilvet etsitään pylväsmaksimista.";
"radar_help.products.title" = "Alin keilaus vai pylväsmaksimi";
"radar_help.tilts.above_1" = "aivan tutkan yläpuolelle";
"radar_help.tilts.above_2" = "ei katso mikään kulma";
"radar_help.tilts.axis_distance" = "Etäisyys tutkasta, km";
"radar_help.tilts.axis_height" = "Korkeus maanpinnasta, km";
"radar_help.tilts.caption" = "Kymmenen kulmaa sivulta, mittakaavassa ja keilan taipumista varten tavallisella 4/3-kertaisella maan säteellä. Korkeudet on venytetty noin viisinkertaisiksi etäisyyksiin nähden. Matalat kulmat ulottuvat 180 kilometriin, 8° päättyy 124 kilometriin ja 12°, 17° ja 25° päättyvät 60 kilometriin (piste 12°:n keilalla). Kuuden alimman kulman keilat leikkaavat 85 kilometrin päässä olevan ukkospilven; 8°:n keila kulkee jo sen huipun yli.";
"radar_help.tilts.p1" = "Jokaisen kierroksen jälkeen antenni kallistuu ylös tai alas ja kiertää uudelleen. DWD:n tutkat käyttävät kymmentä kulmaa: 0,5; 1,5; 2,5; 3,5; 4,5; 5,5; 8; 12; 17 ja 25 astetta. Yhdessä ne muodostavat tilavuuskeilauksen. Vasta kaikilla kymmenellä näkee, kuinka korkealle ukkospilvi ulottuu ja kallistuuko sen ydin.";
"radar_help.tilts.p2" = "Maapallo kaartuu pois keilan alta. Alinkin kulma on 180 kilometrin päässä 3,5 km maanpinnan yläpuolella, joten kaukana tutkasta se ei näe matalista pilvistä satavaa sadetta. Keila myös levenee: se on 1° leveä, mikä tarkoittaa 3 km:ä 180 kilometrin päässä. Ja aivan tutkan yläpuolella on kartio, johon mikään kulma ei katso.";
"radar_help.tilts.p3" = "Kaukana yhdestä tutkasta oleva ukkospilvi on usein lähellä toista. Siksi meteocool täyttää jokaisen 3D-pilven kaikkien siihen ulottuvien tutkien tiedoilla, maasta riippumatta.";
"radar_help.tilts.reach" = "Pyyhkäisyn ulottuvuus riippuu sen kulmasta. Matalat kulmat 5,5°:een asti ulottuvat 180 kilometriin. 8°:n kulma ulottuu 124 kilometriin ja jyrkät kulmat vain 60 kilometriin.";
