"radar_help.turn.bin" = "jedes Kästchen ist ein Bin: 250 m lang, 1° breit";
"radar_help.turn.caption" = "Ein Sweep von oben. Die blaue Linie ist der Strahl, während sich die Antenne dreht. Die farbigen Flächen sind Echos, also Wasser in der Luft, als Regen, Schnee oder Hagel, das einen Teil des Pulses zurückwirft. Die gestrichelten Ringe zeigen die Entfernung zum Radar. Dieser Sweep ist einer der flachen Winkel und reicht deshalb 180 km weit.";
"radar_help.turn.colour" = "seine Farbe ist die dort gemessene Echostärke";
"radar_help.turn.fact_bins" = "720 Bins pro Strahl";
"radar_help.turn.fact_bins_sub" = "je 250 m, bis 180 km";
"radar_help.turn.fact_rays" = "360 Strahlen";
"radar_help.turn.fact_rays_sub" = "einer pro Grad der Umdrehung";
"radar_help.turn.fact_sweep" = "Eine Umdrehung = ein Sweep";
"radar_help.turn.fact_sweep_sub" = "bei einem Winkel, etwa 25 bis 30 s";
"radar_help.turn.p1" = "Ein Wetterradar schickt einen kurzen Mikrowellenpuls entlang eines schmalen Strahls und hört dann zu. Regen, Schnee und Hagel werfen einen kleinen Teil davon zurück. Die Zeit, bis das Echo zurückkommt, ergibt die Entfernung. Die Stärke des Echos ergibt die Reflektivität, gemessen in dBZ. Ein stärkeres Echo bedeutet stärkeren Regen oder Hagel.";
"radar_help.turn.p2" = "Die Antenne dreht sich einmal ganz herum. Eine volle Umdrehung bei einem Neigungswinkel heißt Sweep. Ein deutsches Radar teilt jede Umdrehung in 360 Strahlen, einen pro Grad, und jeden Strahl in kurze Stücke von 250 m, die Bins. Jedes Bin bekommt einen Wert.";
"radar_help.turn.ray" = "Ein Strahl, ganz nah (bei etwa 120 km)";
"radar_help.turn.title" = "Ein Radar, eine Umdrehung";
"radar_help.why.p1" = "Die flache Karte kommt aus dem Niederschlagsscan, der nach einer halben Minute fertig ist. Eine 3D-Wolke braucht alle zehn Winkel, und der letzte endet nach fünf Minuten. Die Wolken eines Zyklus können also frühestens nach etwa sechs Minuten erscheinen, während das flache Bild desselben Zyklus schon nach weniger als drei da ist.";
"radar_help.why.title" = "Warum die 3D-Wolken dem flachen Radar hinterherhängen";
"radar_no_coverage" = "Hier noch kein Radar";
"radar_no_coverage_body" = "Das Live-Radar stammt von den Wetterdiensten Deutschlands, der Schweiz, Frankreichs, Tschechiens, Polens, Belgiens, der Slowakei, Litauens, Estlands, Irlands, Kroatiens, Dänemarks, der Niederlande, Finnlands, Schwedens und Norwegens und deckt deshalb nur diese Länder ab. Blitze und die Wettermodelle funktionieren weltweit.";
