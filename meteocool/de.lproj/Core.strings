"radar_help.open" = "So funktioniert das Radar";
"radar_help.products.p1" = "Die Radarkarte kann zwei Arten von Bild zeigen. Ein unterster Scan zeigt den niedrigsten Sweep jedes Radars: das Echo, das dem Boden am nächsten ist, und damit das, was dem Regen, den man spürt, am nächsten kommt. Weit weg von einem Radar ist auch dieser Sweep hoch oben, wie die Seitenansicht oben zeigt, und Regen aus tiefen Wolken kann fehlen.";
"radar_help.products.p2" = "Ein Säulenmaximum zeigt für jeden Punkt der Karte das stärkste Echo aller Winkel darüber, bis 12 km Höhe. Es zeigt, wo die Kerne der Gewitter sind, auch Regen und Hagel, die noch hoch in der Wolke hängen oder auf dem Weg nach unten verdunsten. Es ist also nicht unbedingt Regen am Boden: Meist wirkt es stärker und größer als der unterste Scan und kann Regen zeigen, wo es unten trocken bleibt.";
"radar_help.products.p3" = "Ein Säulenmaximum braucht den ganzen Volumenscan und ist daher einen Scan oder mehr später dran. DMAX ist das Säulenmaximum des DWD für Deutschland; meteocool baut ein eigenes aus allen sechzehn Netzen. Gewitterzellen und 3D-Wolken werden in einem Säulenmaximum gefunden.";
"radar_help.products.title" = "Unterster Scan oder Säulenmaximum";
"radar_help.tilts.above_1" = "direkt über dem Radar";
"radar_help.tilts.above_2" = "schaut kein Winkel hin";
"radar_help.tilts.axis_distance" = "Entfernung vom Radar, km";
"radar_help.tilts.axis_height" = "Höhe über dem Boden, km";
"radar_help.tilts.caption" = "Die zehn Winkel von der Seite, maßstabsgetreu mit dem üblichen 4/3-Erdradius für die Krümmung des Strahls. Die Höhen sind etwa fünffach gestreckt. Die flachen Winkel reichen 180 km, 8° endet bei 124 km, 12°, 17° und 25° enden bei 60 km (der Punkt am 12°-Strahl). Das Gewitter bei 85 km wird von den sechs flachsten Winkeln geschnitten, der 8°-Strahl geht schon über seine Spitze hinweg.";
"radar_help.tilts.p1" = "Nach jeder Umdrehung neigt sich die Antenne nach oben oder unten und dreht sich erneut. Die Radare des DWD nutzen zehn Winkel: 0,5; 1,5; 2,5; 3,5; 4,5; 5,5; 8; 12; 17 und 25 Grad. Zusammen sind sie der Volumenscan. Nur mit allen zehn sieht man, wie hoch ein Gewitter reicht und ob sein Kern sich neigt.";
"radar_help.tilts.p2" = "Die Erde krümmt sich unter dem Strahl weg. Selbst der flachste Winkel ist in 180 km Entfernung 3,5 km über dem Boden. Weit weg vom Radar verpasst er also Regen aus tiefen Wolken. Der Strahl wird außerdem breiter: Er ist 1° breit, also 3 km bei 180 km. Und direkt über dem Radar gibt es einen Kegel, in den kein Winkel schaut.";
"radar_help.tilts.p3" = "Ein Gewitter weit weg von einem Radar ist oft nah an einem anderen. Deshalb füllt meteocool jede 3D-Wolke mit den Daten jedes Radars, das sie erreicht, egal aus welchem Land.";
"radar_help.tilts.reach" = "Wie weit ein Sweep reicht, hängt von seinem Winkel ab. Die flachen Winkel bis 5,5° reichen 180 km weit. Der 8°-Winkel reicht 124 km, die steilen Winkel nur 60 km.";
"radar_help.tilts.storm" = "ein Gewitter, Spitze bei 11 km";
"radar_help.tilts.title" = "Zehn Winkel ergeben ein Volumen";
"radar_help.tilts.width" = "der 0,5°-Strahl ist 1° breit: 3 km bei 180 km";
