"radar_help.turn.fact_sweep" = "Én omgang = ét sweep";
"radar_help.turn.fact_sweep_sub" = "ved én vinkel, cirka 25 til 30 s";
"radar_help.turn.p1" = "En vejrradar sender en kort puls af mikrobølger ud langs en smal stråle og lytter derefter. Regn, sne og hagl sender en lille del af den tilbage. Tiden, indtil ekkoet kommer tilbage, giver afstanden. Ekkoets styrke giver reflektiviteten, målt i dBZ. Kraftigere ekko betyder kraftigere regn eller hagl.";
"radar_help.turn.p2" = "Antennen drejer én hel omgang rundt. Én fuld omgang ved én vinkel kaldes et sweep. En tysk radar deler hver omgang op i 360 stråler, én pr. grad, og hver stråle i korte stykker på 250 m, der kaldes bins. Hver bin får én værdi.";
"radar_help.turn.ray" = "Én stråle tæt på (ved omkring 120 km)";
"radar_help.turn.title" = "Én radar, én omgang";
"radar_help.why.p1" = "Det flade kort kommer fra nedbørsscannet, som er færdigt et halvt minut inde i cyklussen. En 3D-sky kræver alle ti vinkler, og den sidste slutter fem minutter inde i cyklussen. Derfor kan skyerne for en cyklus ikke dukke op før efter cirka seks minutter, mens cyklussens flade billede er ude efter under tre.";
"radar_help.why.title" = "Hvorfor 3D-skyerne halter efter den flade radar";
