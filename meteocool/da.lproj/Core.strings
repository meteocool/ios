"radar_help.open" = "Sådan virker radaren";
"radar_help.products.p1" = "Radarkortet kan vise to slags billeder. Et laveste scan viser hver radars laveste sweep: ekkoet tættest på jorden og dermed det nærmeste, man kommer den regn, du faktisk mærker. Langt fra en radar er selv det sweep højt oppe, som sidebilledet ovenfor viser, så regn fra lave skyer kan blive overset.";
"radar_help.products.p2" = "Et søjlemaksimum viser for hvert sted på kortet det kraftigste ekko i nogen vinkel over det, op til 12 km. Det viser, hvor uvejrenes kerner er, også regn og hagl, der stadig er højt oppe i skyen og ikke er faldet ned endnu, eller som fordamper på vejen ned. Det er altså ikke nødvendigvis regn ved jorden: det ser som regel kraftigere og bredere ud end det laveste scan og kan vise regn, hvor det er tørt nedenunder.";
"radar_help.products.p3" = "Et søjlemaksimum kræver hele volumenscannet, så det er et scan eller mere bagud. DMAX er DWD's søjlemaksimum for Tyskland; meteocool bygger sit eget ud fra alle seksten netværk. Uvejrscellerne og 3D-skyerne findes i et søjlemaksimum.";
"radar_help.products.title" = "Laveste scan eller søjlemaksimum";
"radar_help.tilts.above_1" = "lige over radaren";
"radar_help.tilts.above_2" = "kigger ingen vinkel";
"radar_help.tilts.axis_distance" = "Afstand fra radaren, km";
"radar_help.tilts.axis_height" = "Højde over jorden, km";
"radar_help.tilts.caption" = "De ti vinkler set fra siden, tegnet i målestok med den sædvanlige jordradius på 4/3 for strålens afbøjning. Højderne er strakt cirka fem gange i forhold til afstanden. De lave vinkler når 180 km, 8° stopper ved 124 km, og 12°, 17° og 25° stopper ved 60 km (prikken på 12°-strålen). Uvejret ved 85 km rammes af de seks laveste vinkler; 8°-strålen passerer allerede over dets top.";
"radar_help.tilts.p1" = "Efter hver omgang vipper antennen op eller ned og drejer igen. DWD's radarer bruger ti vinkler: 0,5°, 1,5°, 2,5°, 3,5°, 4,5°, 5,5°, 8°, 12°, 17° og 25°. Tilsammen udgør de volumenscannet. Kun med alle ti kan man se, hvor højt et uvejr når op, og om dets kerne hælder.";
"radar_help.tilts.p2" = "Jorden krummer væk under strålen. Selv den laveste vinkel er 3,5 km over jorden ved 180 km, så langt fra en radar overser den regn fra lave skyer. Strålen bliver også bredere: den er 1° bred, hvilket er 3 km ved 180 km. Og lige over radaren er der en kegle, hvor ingen vinkel kigger.";
"radar_help.tilts.p3" = "Et uvejr langt fra én radar er ofte tæt på en anden. Derfor fylder meteocool hver 3D-sky med data fra alle radarer, der når den, uanset land.";
"radar_help.tilts.reach" = "Hvor langt et sweep når, afhænger af vinklen. De lave vinkler, op til 5,5°, når 180 km ud. Vinklen på 8° når 124 km, og de stejle vinkler kun 60 km.";
