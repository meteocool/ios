"radar_help.turn.bin" = "hver kasse er én bin: 250 m langs strålen, 1° på tværs";
"radar_help.turn.caption" = "Ét sweep set oppefra. Den blå linje er strålen, mens antennen drejer. De farvede områder er ekkoer, altså vand i luften som regn, sne eller hagl, der sender en del af pulsen tilbage. De stiplede ringe viser afstanden fra radaren. Dette sweep er en af de lave vinkler, så det når 180 km ud.";
"radar_help.turn.colour" = "dens farve er den ekkostyrke, der er målt dér";
