"radar_help.open" = "Slik fungerer radaren";
"radar_help.products.p1" = "Radarkartet kan vise to slags bilder. Et laveste skann viser hver radars laveste sveip: ekkoet nærmest bakken, og dermed det nærmeste du kommer regnet du faktisk kjenner. Langt fra en radar ligger selv dette sveipet høyt oppe, slik sidevisningen over viser, så regn fra lave skyer kan bli oversett.";
"radar_help.products.p2" = "Et kolonnemaksimum viser for hvert punkt på kartet det sterkeste ekkoet i alle elevasjoner over det, opp til 12 km. Det viser hvor kjernene i tordenværene er, også regn og hagl som fortsatt er høyt oppe i skyen og ikke har kommet ned ennå, eller som fordamper på veien ned. Det er altså ikke nødvendigvis regn på bakken: det ser vanligvis sterkere og større ut enn det laveste skannet, og kan vise regn der det er tørt under.";
"radar_help.products.p3" = "Et kolonnemaksimum trenger hele volumskannet, så det ligger ett skann eller mer bak. DMAX er DWDs kolonnemaksimum for Tyskland; meteocool lager sitt eget fra alle seksten nettverkene. Tordencellene og 3D-skyene finnes i et kolonnemaksimum.";
"radar_help.products.title" = "Laveste skann eller kolonnemaksimum";
"radar_help.tilts.above_1" = "rett over radaren";
"radar_help.tilts.above_2" = "ser ingen elevasjon";
"radar_help.tilts.axis_distance" = "Avstand fra radaren, km";
"radar_help.tilts.axis_height" = "Høyde over bakken, km";
"radar_help.tilts.caption" = "De ti elevasjonene sett fra siden, tegnet i målestokk med den vanlige jordradiusen på 4/3 for strålens krumming. Høydene er strukket omtrent fem ganger i forhold til avstanden. De lave elevasjonene når 180 km, 8° stopper ved 124 km, og 12°, 17° og 25° stopper ved 60 km (prikken på 12°-strålen). Tordenværet ved 85 km treffes av de seks laveste elevasjonene; 8°-strålen går allerede over toppen av det.";
"radar_help.tilts.p1" = "Etter hver runde vipper antennen opp eller ned og går en ny runde. DWDs radarer bruker ti elevasjoner: 0,5; 1,5; 2,5; 3,5; 4,5; 5,5; 8; 12; 17 og 25 grader. Til sammen utgjør de volumskannet. Bare med alle ti kan du se hvor høyt et tordenvær når, og om kjernen heller.";
"radar_help.tilts.p2" = "Jorda krummer seg bort under strålen. Selv den laveste elevasjonen ligger 3,5 km over bakken ved 180 km, så langt fra en radar går den glipp av regn fra lave skyer. Strålen blir også bredere: den er 1° bred, altså 3 km ved 180 km. Og rett over radaren er det en kjegle der ingen elevasjon ser.";
"radar_help.tilts.p3" = "Et tordenvær langt fra én radar er ofte nær en annen. Derfor fyller meteocool hver 3D-sky med data fra alle radarer som når den, uansett land.";
"radar_help.tilts.reach" = "Hvor langt et sveip når, avhenger av elevasjonen. De lave elevasjonene, opp til 5,5°, når 180 km. Elevasjonen på 8° når 124 km, og de bratte bare 60 km.";
"radar_help.tilts.storm" = "et tordenvær, topp ved 11 km";
"radar_help.tilts.title" = "Ti elevasjoner blir ett volum";
