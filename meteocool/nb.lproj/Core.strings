"radar_help.turn.bin" = "hver boks er én rute: 250 m langs radialen, 1° på tvers";
"radar_help.turn.caption" = "Ett sveip sett ovenfra. Den blå linjen er strålen mens antennen dreier. De fargede områdene er ekko, altså vann i lufta – regn, snø eller hagl – som sender en del av pulsen tilbake. De stiplede ringene viser avstanden fra radaren. Dette sveipet er en av de lave elevasjonene, så det når 180 km.";
"radar_help.turn.colour" = "fargen er ekkostyrken som er målt der";
"radar_help.turn.fact_bins" = "720 ruter per radial";
"radar_help.turn.fact_bins_sub" = "250 m hver, ut til 180 km";
"radar_help.turn.fact_rays" = "360 radialer";
"radar_help.turn.fact_rays_sub" = "én per grad av runden";
"radar_help.turn.fact_sweep" = "Én runde = ett sveip";
"radar_help.turn.fact_sweep_sub" = "ved én elevasjon, omtrent 25 til 30 s";
"radar_help.turn.p1" = "En værradar sender en kort puls med mikrobølger langs en smal stråle og lytter deretter. Regn, snø og hagl sender en liten del av den tilbake. Tiden det tar før ekkoet kommer tilbake, gir avstanden. Styrken på ekkoet gir reflektiviteten, målt i dBZ. Sterkere ekko betyr kraftigere regn eller hagl.";
"radar_help.turn.p2" = "Antennen går én hel runde rundt. Én hel runde ved én elevasjon kalles et sveip. En tysk radar deler hver runde i 360 radialer, én per grad, og hver radial i korte biter på 250 m, kalt ruter. Hver rute får én verdi.";
"radar_help.turn.ray" = "Én radial på nært hold (ved ca. 120 km)";
"radar_help.turn.title" = "Én radar, én runde";
"radar_help.why.p1" = "Det flate kartet kommer fra nedbørskannet, som er ferdig et halvt minutt ut i syklusen. En 3D-sky trenger alle ti elevasjonene, og den siste er ferdig fem minutter ut i syklusen. Derfor kan skyene for en syklus ikke dukke opp før etter omtrent seks minutter, mens den flate rammen for samme syklus er ute etter mindre enn tre.";
"radar_help.why.title" = "Hvorfor 3D-skyene ligger etter det flate radarkartet";
