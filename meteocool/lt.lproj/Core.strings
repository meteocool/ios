"radar_help.products.p1" = "Radaro žemėlapis gali rodyti dviejų rūšių vaizdą. Žemiausias skenavimas rodo kiekvieno radaro žemiausią skenavimą: aidą arčiausiai žemės, taigi tai, kas labiausiai atitinka lietų, kurį iš tikrųjų pajusi. Toli nuo radaro net šis skenavimas yra aukštai, kaip rodo vaizdas iš šono aukščiau, todėl lietus iš žemų debesų gali būti nepastebėtas.";
"radar_help.products.p2" = "Stulpelio maksimumas kiekvienam žemėlapio taškui rodo stipriausią aidą bet kuriame virš jo esančiame kampe, iki 12 km. Taip matyti, kur yra audrų branduoliai, įskaitant lietų ir krušą, kurie dar aukštai debesyje ir dar nenukrito arba pakeliui žemyn išgaruoja. Todėl tai nebūtinai lietus ant žemės: paprastai jis atrodo stipresnis ir platesnis nei žemiausias skenavimas ir gali rodyti lietų ten, kur apačioje sausa.";
"radar_help.products.p3" = "Stulpelio maksimumui reikia viso tūrinio skenavimo, todėl jis atsilieka vienu ar daugiau skenavimų. DMAX – tai DWD stulpelio maksimumas Vokietijai; meteocool savąjį sudaro iš visų šešiolikos tinklų. Audrų celės ir 3D debesys randami stulpelio maksimume.";
"radar_help.products.title" = "Žemiausias skenavimas ar stulpelio maksimumas";
"radar_help.tilts.above_1" = "tiesiai virš radaro";
"radar_help.tilts.above_2" = "nežiūri joks kampas";
"radar_help.tilts.axis_distance" = "Atstumas nuo radaro, km";
"radar_help.tilts.axis_height" = "Aukštis virš žemės, km";
"radar_help.tilts.caption" = "Dešimties kampų vaizdas iš šono, nubraižytas masteliu, pluošto lenkimuisi naudojant įprastą 4/3 Žemės spindulį. Aukščiai, palyginti su atstumu, ištempti maždaug penkis kartus. Žemieji kampai siekia 180 km, 8° baigiasi ties 124 km, o 12°, 17° ir 25° – ties 60 km (taškas ant 12° pluošto). Audrą 85 km atstumu kerta šeši žemiausi kampai; 8° pluoštas jau praeina virš jos viršūnės.";
"radar_help.tilts.p1" = "Po kiekvieno apsisukimo antena pakyla arba nusileidžia ir vėl sukasi. DWD radarai naudoja dešimt kampų: 0,5; 1,5; 2,5; 3,5; 4,5; 5,5; 8; 12; 17 ir 25 laipsnius. Kartu jie sudaro tūrinį skenavimą. Tik turint visus dešimt galima matyti, kaip aukštai siekia audra ir ar jos branduolys pasviręs.";
"radar_help.tilts.p2" = "Žemė po pluoštu išlinksta tolyn. Net žemiausias kampas 180 km atstumu yra 3,5 km virš žemės, todėl toli nuo radaro jis nemato lietaus, krintančio iš žemų debesų. Pluoštas taip pat platėja: jis 1° pločio, o tai 180 km atstumu sudaro 3 km. O tiesiai virš radaro yra kūgis, į kurį nežiūri joks kampas.";
"radar_help.tilts.p3" = "Audra, esanti toli nuo vieno radaro, dažnai būna arti kito. Todėl meteocool kiekvieną 3D debesį užpildo duomenimis iš visų jį pasiekiančių radarų, iš bet kurios šalies.";
"radar_help.tilts.reach" = "Kaip toli siekia skenavimas, priklauso nuo jo kampo. Žemieji kampai, iki 5,5°, siekia 180 km. 8° kampas siekia 124 km, o statieji – tik 60 km.";
