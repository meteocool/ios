"radar_help.open" = "Kako radi radar";
"radar_help.products.p1" = "Radarska karta može prikazati dvije vrste slike. Najniži sken prikazuje najniži prolaz svakog radara: odjek najbliži tlu, dakle ono što je najbliže kiši koju ćeš stvarno osjetiti. Daleko od radara čak je i taj prolaz visoko, kao što pokazuje bočni pogled iznad, pa se kiša iz niskih oblaka može propustiti.";
"radar_help.products.p2" = "Maksimum stupca za svaku točku na karti prikazuje najjači odjek u bilo kojoj elevaciji iznad nje, do 12 km. Tako se vidi gdje su olujne jezgre, uključujući kišu i tuču koje su još visoko u oblaku i još nisu pale ili koje ispare na putu prema dolje. Zato to nije nužno kiša na tlu: obično izgleda jače i šire od najnižeg skena i može pokazivati kišu ondje gdje je ispod suho.";
"radar_help.products.p3" = "Maksimumu stupca treba cijeli volumni sken, pa kasni jedan sken ili više. DMAX je maksimum stupca DWD-a za Njemačku; meteocool izrađuje vlastiti iz svih šesnaest mreža. Olujne ćelije i 3D oblaci pronalaze se u maksimumu stupca.";
"radar_help.products.title" = "Najniži sken ili maksimum stupca";
"radar_help.tilts.above_1" = "točno iznad radara";
"radar_help.tilts.above_2" = "ne gleda nijedna elevacija";
"radar_help.tilts.axis_distance" = "Udaljenost od radara, km";
"radar_help.tilts.axis_height" = "Visina iznad tla, km";
"radar_help.tilts.caption" = "Bočni pogled na deset elevacija, u mjerilu, s uobičajenim efektivnim polumjerom Zemlje od 4/3 za savijanje zrake. Visine su razvučene oko pet puta u odnosu na udaljenost. Niske elevacije sežu 180 km, 8° staje na 124 km, a 12°, 17° i 25° staju na 60 km (točka na zraci od 12°). Oluju na 85 km sijeku šest najnižih elevacija; zraka od 8° već prolazi iznad njezina vrha.";
"radar_help.tilts.p1" = "Nakon svakog okretaja antena se podigne ili spusti i ponovno okrene. Radari DWD-a koriste deset elevacija: 0,5; 1,5; 2,5; 3,5; 4,5; 5,5; 8; 12; 17 i 25 stupnjeva. Zajedno čine volumni sken. Tek sa svih deset vidi se koliko visoko seže oluja i je li joj jezgra nagnuta.";
"radar_help.tilts.p2" = "Zemlja se pod zrakom zakrivljuje. Čak je i najniža elevacija na 180 km udaljenosti 3,5 km iznad tla, pa daleko od radara propušta kišu iz niskih oblaka. Zraka se i širi: široka je 1°, što na 180 km iznosi 3 km. A točno iznad radara postoji stožac u koji ne gleda nijedna elevacija.";
"radar_help.tilts.p3" = "Oluja daleko od jednog radara često je blizu drugoga. Zato meteocool svaki 3D oblak popunjava podacima svih radara koji do njega dosežu, iz bilo koje zemlje.";
"radar_help.tilts.reach" = "Koliko daleko prolaz seže ovisi o njegovoj elevaciji. Niske elevacije, do 5,5°, sežu 180 km. Elevacija od 8° seže 124 km, a strme samo 60 km.";
