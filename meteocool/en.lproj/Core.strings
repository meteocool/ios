"radar_help.title" = "How the Radar Works";
"radar_help.turn.bin" = "each box is one bin: 250 m along the ray, 1° across";
"radar_help.turn.caption" = "Top view of one sweep. The blue line is the beam as the antenna turns. The coloured areas are echoes, that is water in the air, as rain, snow or hail, sending part of the pulse back. The dashed rings show the distance from the radar. This sweep is one of the low tilts, so it reaches 180 km.";
"radar_help.turn.colour" = "its colour is the echo strength measured there";
"radar_help.turn.fact_bins" = "720 bins per ray";
"radar_help.turn.fact_bins_sub" = "250 m each, out to 180 km";
"radar_help.turn.fact_rays" = "360 rays";
"radar_help.turn.fact_rays_sub" = "one per degree of the turn";
"radar_help.turn.fact_sweep" = "One turn = one sweep";
"radar_help.turn.fact_sweep_sub" = "at one tilt, roughly 25 to 30 s";
"radar_help.turn.p1" = "A weather radar sends a short pulse of microwaves along a narrow beam and then listens. Rain, snow and hail send a small part of it back. The time until the echo returns gives the distance. The strength of the echo gives the reflectivity, measured in dBZ. Stronger echo means heavier rain or hail.";
"radar_help.turn.p2" = "The antenna turns once all the way around. One full turn at one tilt is called a sweep. A German radar cuts each turn into 360 rays, one per degree, and each ray into short pieces of 250 m called bins. Every bin gets one value.";
"radar_help.turn.ray" = "One ray, close up (at about 120 km)";
"radar_help.turn.title" = "One Radar, One Turn";
"radar_help.why.p1" = "The flat map comes from the precipitation scan, which is done half a minute into the cycle. A 3D cloud needs all ten tilts, and the last one ends five minutes into the cycle. So the clouds for a cycle cannot appear before about six minutes, while that cycle's flat frame is out after less than three.";
"radar_help.why.title" = "Why the 3D Clouds Trail the Flat Radar";
"radar_no_coverage" = "No Radar Here Yet";
"radar_no_coverage_body" = "Live radar comes from the weather services of Germany, Switzerland, France, Czechia, Poland, Belgium, Slovakia, Lithuania, Estonia, Ireland, Croatia, Denmark, the Netherlands, Finland, Sweden and Norway, so it only covers those countries. Lightning and the forecast models work worldwide.";
