"radar_help.turn.caption" = "Eén sweep van bovenaf. De blauwe lijn is de bundel terwijl de antenne draait. De gekleurde vlakken zijn echo's, dus water in de lucht, als regen, sneeuw of hagel, dat een deel van de puls terugkaatst. De gestippelde ringen tonen de afstand tot de radar. Deze sweep is een van de lage hoeken en reikt daarom 180 km ver.";
"radar_help.turn.colour" = "de kleur is de daar gemeten echosterkte";
"radar_help.turn.fact_bins" = "720 bins per straal";
"radar_help.turn.fact_bins_sub" = "elk 250 m, tot 180 km";
"radar_help.turn.fact_rays" = "360 stralen";
"radar_help.turn.fact_rays_sub" = "één per graad van de draai";
"radar_help.turn.fact_sweep" = "Eén draai = één sweep";
"radar_help.turn.fact_sweep_sub" = "bij één hoek, zo'n 25 tot 30 s";
"radar_help.turn.p1" = "Een weerradar stuurt een korte puls microgolven langs een smalle bundel en luistert dan. Regen, sneeuw en hagel kaatsen een klein deel terug. De tijd tot de echo terugkomt, geeft de afstand. De sterkte van de echo geeft de reflectiviteit, gemeten in dBZ. Een sterkere echo betekent zwaardere regen of hagel.";
"radar_help.turn.p2" = "De antenne draait één keer helemaal rond. Eén volle draai bij één hoek heet een sweep. Een Duitse radar deelt elke draai in 360 stralen, één per graad, en elke straal in korte stukjes van 250 m, de bins. Elke bin krijgt één waarde.";
"radar_help.turn.ray" = "Eén straal, van dichtbij (op zo'n 120 km)";
"radar_help.turn.title" = "Eén radar, één rondje";
"radar_help.why.p1" = "De platte kaart komt uit de neerslagscan, die na een halve minuut klaar is. Een 3D-wolk heeft alle tien hoeken nodig, en de laatste eindigt na vijf minuten. De wolken van een cyclus kunnen dus niet voor ongeveer zes minuten verschijnen, terwijl het platte beeld van dezelfde cyclus er al binnen drie minuten is.";
"radar_help.why.title" = "Waarom de 3D-wolken achterlopen op de platte radar";
"radar_no_coverage" = "Hier nog geen radar";
"radar_no_coverage_body" = "Live radar komt van de weerdiensten van Duitsland, Zwitserland, Frankrijk, Tsjechië, Polen, België, Slowakije, Litouwen, Estland, Ierland, Kroatië, Denemarken, Nederland, Finland, Zweden en Noorwegen, en dekt dus alleen die landen. Bliksem en de voorspellingsmodellen werken wereldwijd.";
