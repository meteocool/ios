# Devices to capture App Store screenshots on. These have to exist as
# simulators in the installed Xcode — check with:
#
#     xcrun simctl list devices available
#
devices([
  "iPhone 15 Pro Max",
  "iPhone 15",
  "iPad Pro 13-inch (M4)",
])

languages([
  "en-US",
  #"de-DE",
])

