default_platform(:ios)

# Regenerates meteocool.xcodeproj from ../project.yml before every lane.
# The project is generated by XcodeGen and is not in the repo.
before_all do
  Dir.chdir("..") { sh("xcodegen", "generate") }
end

# Writes the build number to CURRENT_PROJECT_VERSION in Config/Base.xcconfig.
# agvtool and increment_build_number write to project.pbxproj instead, and the
# next `xcodegen generate` discards that change.
def bump_build_number(new_value)
  path = File.expand_path("../Config/Base.xcconfig", __dir__)
  contents = File.read(path)
  updated = contents.sub(/^CURRENT_PROJECT_VERSION = .*$/,
                         "CURRENT_PROJECT_VERSION = #{new_value}")
  UI.user_error!("CURRENT_PROJECT_VERSION not found in #{path}") if updated == contents
  File.write(path, updated)
  UI.success("CURRENT_PROJECT_VERSION = #{new_value}")
end

platform :ios do
  lane :beta do
    bump_build_number(latest_testflight_build_number + 1)
    sh("xcodegen", "generate", log: false) # pick up the new build number
    build_app(scheme: "meteocool")
    upload_to_testflight(skip_waiting_for_build_processing: true)
  end

  lane :screenshots do
    capture_screenshots(scheme: "meteocoolUITests",
        clear_previous_screenshots: true,
        clean: true,
        concurrent_simulators: false,
        erase_simulator: true,
        reinstall_app: true
        )
    #upload_to_app_store(skip_binary_upload: true, skip_metadata: true)
  end
end
