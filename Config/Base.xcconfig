// Settings shared by every configuration and target.
//
// Local.xcconfig overrides machine- or account-specific values (signing team,
// bundle id prefix). It is optional, gitignored, and included at the bottom of
// this file. Copy Local.xcconfig.example to create it.

// ---- Identity -------------------------------------------------------------

// Reverse-DNS prefix all bundle identifiers are built from.
// Override locally if you sign with your own Apple Developer team.
BUNDLE_PREFIX = org.frcy.app

// Apple Developer Team ID used for automatic signing.
DEVELOPMENT_TEAM = 4L2672L4VX

// ---- Versioning -----------------------------------------------------------

MARKETING_VERSION = 4.0.0
CURRENT_PROJECT_VERSION = 31

// ---- Local overrides (never committed) ------------------------------------
// The `?` makes the include optional: builds work without the file.
#include? "Local.xcconfig"
#include? "../Local.xcconfig"
